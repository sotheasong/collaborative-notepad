# Copy this file to .env and adjust as needed. All values are optional;
# the defaults below are what the app uses when no .env is present.

# Directory where notes are stored on disk (created automatically).
STORAGE_PATH=./storage

# Host/port the Flask development server binds to.
# Use 127.0.0.1 to restrict access to your own machine.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
